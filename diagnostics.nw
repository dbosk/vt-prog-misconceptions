import collections
import contextlib
import csv
import glob
import io
import json
import os
import re
import sys

<<the quiz files are the answer key>>
<<recover the aspect and the form from the names>>
<<match report columns to pool questions>>
<<the student behind a row>>
<<attach the login IDs>>
<<fetch the results from Canvas>>
<<the consent filter>>
