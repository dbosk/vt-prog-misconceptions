<<[[analyze_diagnostics.py]]>>=
"""Fetch and summarise the diagnostic-quiz results.

The quizzes are defined in the quiz-*.json files tangled from the same
literate source as this program (the appendix of the paper); those
files are also this program's answer key.  The results come straight
from Canvas via canvaslms.

Run --self-test to check the pure functions against the quiz files
without touching Canvas.
"""

import argparse
import collections
import csv
import glob
import json
import os
import re
import sys

<<the quiz files are the answer key>>
<<recover the aspect and the form from the names>>
<<match report columns to pool questions>>
<<fetch the results from Canvas>>
<<classify one student's answer to one question>>
<<collect the tidy rows for one quiz>>
<<summarise the aspects>>
<<self-test against the quiz files>>
<<analysis main>>

