    by_name.setdefault(user.name, []).append(login)
@

The report's column headings are Canvas's, so we find the two ID
columns by name once and reuse them for every row.
The three lookups are tried in turn and the first that answers wins,
which is also the order of how much we trust them.
A row that none of them answers is left without the column, which is
exactly what [[student_of]] reads as \enquote{fall back}.

<<look each row up in that index>>=
if not rows:
    return
id_column = next((c for c in rows[0] if c.strip().lower() == "id"), None)
sis_column = next((c for c in rows[0]
                   if c.strip().lower() == "sis_id"), None)
for row in rows:
    login = None
    if id_column and row.get(id_column):
        login = by_id.get(str(row[id_column]).strip())
    if not login and sis_column and row.get(sis_column):
        login = by_sis.get(str(row[sis_column]).strip())
    if not login:
        candidates = by_name.get(row[STUDENT], [])
        if len(candidates) == 1:
            login = candidates[0]
        elif len(candidates) > 1:
            print(f"warning: several students in {COURSE} are named"
                  f" {row[STUDENT]!r} and the report has no usable ID"
                  f" column; falling back to the name, which cannot"
                  f" tell them apart")
    if login:
        row[LOGIN_COLUMN] = login
@

\subsubsection{Fetching the results}

Just as the quizzes are created with [[canvaslms]], the results are
extracted with it: the package provides the credentials, the course
lookup and the report machinery, so the program reuses them instead of
reimplementing the Canvas API calls.
The report is generated on demand by Canvas, so we request it --- with
all versions included, in case a quiz was edited after some students
answered --- poll it until Canvas marks it complete, and download the
CSV it points to.
The fetcher also attaches each row's login ID while the [[course]]
object is at hand, so every report the rest of the program sees
already knows who its rows belong to.

<<fetch the results from Canvas>>=
def fetch_results(course_name, quiz_title):
    """Download the student-analysis rows for one quiz."""
    import appdirs
    import requests
    import canvaslms.cli
    import canvaslms.cli.login
    from canvasapi import Canvas
    from canvaslms.cli.quizzes import (
        filter_quizzes,
        is_new_quiz,
        poll_progress,
    )

    config_file = os.path.join(
        appdirs.user_config_dir("canvaslms"), "config.json"
    )
    config = canvaslms.cli.read_configuration(config_file)
    hostname, token = canvaslms.cli.login.load_credentials(config)
    if not hostname.startswith("http"):
        hostname = f"https://{hostname}"
    canvas = Canvas(hostname, token)

    course = next(
        c for c in canvas.get_courses()
        if course_name in (c.name or "")
        or course_name in (c.course_code or "")
    )
    quiz = next(filter_quizzes([course], re.escape(quiz_title)))
    if is_new_quiz(quiz):
        sys.exit(f"quiz {quiz.title!r} is not a Classic Quiz")

    report = quiz.create_report(
        report_type="student_analysis", includes_all_versions=True
    )
    for _ in range(30):
        report = quiz.get_quiz_report(report.id)
        if poll_progress(report, max_attempts=1):
            break
    file = getattr(report, "file", None)
    url = (
        file.get("url") if isinstance(file, dict)
        else getattr(file, "url", None)
    )
    if not url:
        sys.exit("Canvas did not produce the student-analysis report")
    response = requests.get(url)
    response.raise_for_status()
    rows = list(csv.DictReader(response.text.splitlines()))
    attach_logins(rows, course)
    return rows
@

\subsubsection{Consent}

Consent is asked once, in the course-level start quiz
(\cref{app:diagnostics-ethics}), and covers all eighteen quizzes; the
other seventeen carry no consent item of their own, so every quiz's
rows are filtered by the students who answered yes at the start.
The program reads the consent question from the tangled quiz files,
like the answer key, so the filter cannot drift from the instrument
any more than the key can.
When the course-start report is missing, or carries no consent
column, there is nothing to filter by; the program then says so and
keeps every row rather than guessing silently in either direction ---
a state that only a dry run should ever see, since the start quiz
runs before any quiz whose rows would need filtering.

<<the consent filter>>=
def load_consent(pattern="quiz-*.json"):
    """Return (quiz title, consent question text) from the quiz files.

    The consent question is the ungrouped question named `Consent`;
    (None, None) when no tangled quiz carries one.
    """
    for path in sorted(glob.glob(pattern)):
        quiz = json.load(open(path))
        for entry in quiz["questions"]:
            if "group" in entry:
                continue
            if entry.get("question_name") == "Consent":
                return quiz["settings"]["title"], entry["question_text"]
    return None, None
@

Finding the consent column repeats the normalise-and-contain matching
of [[column_for]], but on a question text alone rather than a pool
question, so it gets its own function instead of overloading that
one's contract.
One guard is added: the containment fallback exists for truncated
headers, but a short metadata head must not pass it --- [[id]] is a
substring of \enquote{pseudonymised} --- so heads shorter than the
words \enquote{I consent} are out of the running.

<<the consent filter>>=
def consent_column(fieldnames, text):
    """Return the report column carrying the consent question, or None."""
    target = normalise(text)
    heads = {
        name: normalise(re.sub(r"^\d+: ", "", name or ""))
        for name in fieldnames
    }
    for name, head in heads.items():
        if head == target:
            return name
    for name, head in heads.items():
        if len(head) >= len("I consent") and (head in target
                                              or target in head):
            return name
    return None
@

The consent set holds the students who answered yes, keyed by
[[student_of]] like every other join; [[None]] means the question was
not found at all, which the caller must distinguish from an empty set
--- nobody consenting filters everything, the question being absent
filters nothing.

<<the consent filter>>=
def consenting(report, text):
    """Return the students who answered yes, or None without the column."""
    if not report or text is None:
        return None
    column = consent_column(report[0].keys(), text)
    if column is None:
        return None
    return {
        student_of(row) for row in report
        if normalise(row[column] or "").lower() in ("yes", "true")
    }


def filter_consent(rows, students):
    """Keep the rows of the consenting students; None keeps every row."""
    if students is None:
        return rows
    return [row for row in rows if student_of(row) in students]
@

A student's cell in the report holds the chosen answer's text.
We match it against the question's choices, normalised on both sides,
and record the chosen position; matching on text rather than position
is forced by the report format, and is safe because no question has
two identical choices.

<<classify one student's answer to one question>>=
def classify(cell, question):
    """Return (chosen position or None, correct or None) for one cell.

    `None` means the student left the question unanswered or the cell
    text matches no choice (e.g. a report-format change).
    """
    text = normalise(cell or "")
    if not text:
        return None, None
    for position, choice in question["choices"].items():
        if text == normalise(choice):
            return position, position == question["correct"]
    return None, None
@

One quiz's rows become tidy rows: one per student and aspect, carrying
everything the later statistical analysis needs to pair, split and
aggregate --- including the drawn form, so that form effects can
themselves be checked.
The report has a column for every question in every pool, but a
student has an answer only under the form Canvas drew for them, so
the answered column identifies the form.
An aspect with no answered column is still one row, with an empty
form: the student left it unanswered, and the report does not say
which form they saw.

<<collect the tidy rows for one quiz>>=
def tidy_rows(quiz_title, aspects, report):
    """Yield one dict per student and aspect in the report."""
    for row in report:
        student = student_of(row)
        for number, aspect in sorted(aspects.items()):
            chosen = correct = form = None
            answer = ""
            for question_name, question in aspect["forms"].items():
                column = column_for(question, row.keys())
                if column is None or not (row[column] or "").strip():
                    continue
                chosen, correct = classify(row[column], question)
                form = form_of(question_name)
                answer = question["choices"].get(chosen, "")
                break
            yield {
                "quiz": quiz_title,
                "student": student,
                "aspect": number,
                "label": aspect["label"],
                "form": form,
                "chosen": chosen,
                "answer": answer,
                "correct": correct,
            }
@

The summary prints, per aspect, the number of correct answers in each
quiz that carries it, and the distribution of the wrong answers over
the choices --- the misconception profile.

<<summarise the aspects>>=
def summarise(rows):
    """Print per-aspect correctness and wrong-answer distributions."""
    by_aspect = collections.defaultdict(list)
    for row in rows:
        by_aspect[(row["aspect"], row["label"])].append(row)
    for (number, label), answers in sorted(by_aspect.items()):
        print(f"\n[{number}] {label}")
        by_quiz = collections.defaultdict(list)
        for answer in answers:
            by_quiz[answer["quiz"]].append(answer)
        for quiz, quiz_answers in sorted(by_quiz.items()):
            n = len(quiz_answers)
            right = sum(1 for a in quiz_answers if a["correct"])
            print(f"  {quiz}: {right}/{n} correct")
            wrong = collections.Counter(
                a["answer"] for a in quiz_answers
                if a["correct"] is False
            )
            for answer, count in wrong.most_common():
                print(f"    {count}x {answer[:60]}")
@

The self-test exercises the pure functions against the tangled quiz
files, so the build can check the program without Canvas credentials:
every group must hold exactly forms A and B and draw one of them for
one point; every question's correct answer text must classify back to
its correct position; and the before- and after-quiz of every pair
must hold the same pools, since the draw --- not the quiz --- decides
which form a student meets.
The identity and consent machinery is checked on stand-ins at the
end, below.

<<self-test against the quiz files>>=
def self_test():
    """Check the answer key and the pure functions; exit non-zero on failure."""
    key = load_key()
    assert key, "no quiz files found; run make programs first"
    failures = 0
    for path in sorted(glob.glob("quiz-*.json")):
        for entry in json.load(open(path))["questions"]:
            if "group" not in entry:
                continue
            spec = entry["group"]
            if (spec.get("pick_count"), spec.get("question_points")) != (1, 1):
                failures += 1
                print(f"FAIL {path}: {spec['name']!r} "
                      f"does not draw one form for one point")
    for quiz_title, aspects in key.items():
        for number, aspect in aspects.items():
            forms = sorted(form_of(name) or "?" for name in aspect["forms"])
            if forms != ["A", "B"]:
                failures += 1
                print(f"FAIL {quiz_title} [{number}]: pool holds {forms}")
            for question_name, question in aspect["forms"].items():
                correct_text = question["choices"][question["correct"]]
                chosen, correct = classify(correct_text, question)
                if not (chosen == question["correct"] and correct):
                    failures += 1
                    print(f"FAIL {quiz_title} [{number}] {question_name}: "
                          f"key does not round-trip")
    for title, aspects in key.items():
        if "(before)" in title or "start of course" in title:
            partner = title.replace("(before)", "(after)").replace(
                "start of course", "end of course"
            )
            for number, aspect in aspects.items():
                other = key[partner][number]
                if sorted(aspect["forms"]) != sorted(other["forms"]):
                    failures += 1
                    print(f"FAIL {title} [{number}]: pools differ pre/post")
    <<check identity and consent on stand-ins>>
    print(f"self-test: {'FAIL' if failures else 'OK'}")
    sys.exit(1 if failures else 0)
@

The case the identity machinery exists for is two students who share a
name: given an ID column the two rows must come out as two students,
and given only the name the program must warn and resolve nothing.
The consent checks build a one-question report from the tangled
consent question itself: the consent set must hold exactly the
yes-answers, filtering must keep exactly those rows, and a report
without the consent column must yield [[None]] --- filter nothing ---
rather than an empty set, which would filter everything.

<<check identity and consent on stand-ins>>=
class FakeUser:
    """A roster entry with the attributes the lookup reads."""

    def __init__(self, user_id, name, login_id):
        self.id = user_id
        self.name = name
        self.login_id = login_id

class FakeCourse:
    """A course whose roster is a fixed list of users."""

    def __init__(self, users):
        self.users = users

    def get_users(self, **kwargs):
        return self.users

namesakes = FakeCourse([FakeUser(1, "Ann Andersson", "ann@kth.se"),
                        FakeUser(2, "Ann Andersson", "anna@kth.se")])
rows = [{"id": "1", STUDENT: "Ann Andersson"},
        {"id": "2", STUDENT: "Ann Andersson"}]
attach_logins(rows, namesakes)
if [student_of(row) for row in rows] != ["ann@kth.se", "anna@kth.se"]:
    failures += 1
    print("FAIL: the id column does not tell namesakes apart")
rows = [{STUDENT: "Ann Andersson"}]
notes = io.StringIO()
with contextlib.redirect_stdout(notes):
    attach_logins(rows, namesakes)
if LOGIN_COLUMN in rows[0] or "warning" not in notes.getvalue():
    failures += 1
    print("FAIL: an ambiguous name resolved instead of warning")
title, text = load_consent()
if title is None:
    failures += 1
    print("FAIL: no consent question in the tangled quizzes")
else:
    head = f"1234: {strip_html(text)}"
    report = [{STUDENT: "Ann", LOGIN_COLUMN: "ann@kth.se", head: "Yes"},
              {STUDENT: "Bo", LOGIN_COLUMN: "bo@kth.se", head: "No"}]
    students = consenting(report, text)
    if students != {"ann@kth.se"}:
        failures += 1
        print("FAIL: the consent set is not exactly the yes-answers")
    if filter_consent(report, students) != report[:1]:
        failures += 1
        print("FAIL: consent filtering keeps the wrong rows")
    if consenting([{STUDENT: "Ann"}], text) is not None:
        failures += 1
        print("FAIL: a report without the consent column must be None")
@

The main function ties the pieces together: load the key, fetch every
quiz's report, derive the consenting students from the course-start
report, accumulate the tidy rows of those students only, write them to
the output CSV and print the summaries.
Quizzes without responses yet are reported and skipped, so the program
can run mid-course; the reports are all fetched before any is tidied,
because the consent set must be in hand before the first row is kept
or dropped.

<<analysis main>>=
def main():
    """Run the analysis per the command line."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--course", default=COURSE,
                        help=f"course name (default: {COURSE})")
    parser.add_argument("-o", "--output", default="diagnostics-results.csv",
                        help="tidy per-answer CSV to write")
    parser.add_argument("--self-test", action="store_true",
                        help="check the key and pure functions, no Canvas")
    args = parser.parse_args()
    if args.self_test:
        self_test()
    key = load_key()
    reports = {}
    for quiz_title in key:
        try:
            report = fetch_results(args.course, quiz_title)
        except StopIteration:
            print(f"skipping {quiz_title!r}: not found in {args.course!r}")
            continue
        if not report:
            print(f"skipping {quiz_title!r}: no responses yet")
            continue
        reports[quiz_title] = report
    consent_title, consent_text = load_consent()
    students = consenting(reports.get(consent_title), consent_text)
    if students is None:
        print("note: no consent answers to filter by; keeping every row")
    rows = []
    for quiz_title, report in reports.items():
        rows.extend(tidy_rows(quiz_title, key[quiz_title],
                              filter_consent(report, students)))
    if not rows:
        sys.exit("no responses in any quiz")
    with open(args.output, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=list(rows[0].keys()))
        writer.writeheader()
        writer.writerows(rows)
    print(f"wrote {len(rows)} answers to {args.output}")
    summarise(rows)
@
